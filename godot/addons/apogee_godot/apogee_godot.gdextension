[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../target/debug/libapogee_godot.so"
linux.release.x86_64 = "res://../target/release/libapogee_godot.so"
macos.debug = "res://../target/debug/libapogee_godot.dylib"
macos.release = "res://../target/release/libapogee_godot.dylib"
windows.debug.x86_64 = "res://../target/debug/apogee_godot.dll"
windows.release.x86_64 = "res://../target/release/apogee_godot.dll"
